{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["node_modules/**", "dist/**", "coverage/**", "public/**"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-ignore": "allow-with-description",
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "import/no-duplicates": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "eqeqeq": ["error", "smart"],
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/renderer/src/core/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "core/ is pure TypeScript (TDD 4.2)."
              },
              {
                "name": "react-dom",
                "message": "core/ is pure TypeScript (TDD 4.2)."
              },
              {
                "name": "react-hook-form",
                "message": "core/ is pure TypeScript (TDD 4.2)."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/fields",
                  "**/fields/**",
                  "**/engine",
                  "**/engine/**",
                  "**/ui",
                  "**/ui/**",
                  "**/api",
                  "**/api/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/*.css"
                ],
                "message": "core/ may only depend on itself and zod (TDD 4.2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/renderer/src/fields/**/definition/index.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "A kind definition is pure; React belongs in Component.tsx."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/default-kit",
                  "**/default-kit/**",
                  "**/engine",
                  "**/engine/**",
                  "**/api",
                  "**/api/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/*.css",
                  "**/ui-kit",
                  "**/ui-kit/**",
                  "**/provider",
                  "**/provider/**"
                ],
                "message": "A kind definition may only import core/ (TDD 4.2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/renderer/src/fields/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/api",
                  "**/api/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/engine",
                  "**/engine/**",
                  "**/*.css",
                  "**/default-kit",
                  "**/default-kit/**"
                ],
                "message": "Field components render through the UI kit from the provider, never the default kit, and never touch the network or styles (ADR-0015, TDD 4.2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/renderer/src/engine/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/*.css", "**/*.module.css", "**/*.scss"],
                "message": "The form engine must not import styles; it renders through the UI kit (ADR-0007, ADR-0015)."
              },
              {
                "group": ["**/api", "**/api/**", "**/mocks", "**/mocks/**"],
                "message": "The engine has no network code; onSubmit is injected (TDD 6.3)."
              },
              {
                "group": ["**/default-kit", "**/default-kit/**"],
                "message": "The engine renders through the UI kit from the provider, never the default kit (ADR-0015)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/renderer/src/default-kit/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/core",
                  "**/core/**",
                  "**/fields",
                  "**/fields/**",
                  "**/engine",
                  "**/engine/**",
                  "**/api",
                  "**/api/**",
                  "**/mocks",
                  "**/mocks/**",
                  "**/provider",
                  "**/provider/**"
                ],
                "message": "default-kit/ components are presentation only: they may import the kit contract and nothing of the engine, fields or core (ADR-0015)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/renderer/src/ui-kit/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/default-kit",
                  "**/default-kit/**",
                  "**/provider",
                  "**/provider/**",
                  "**/engine",
                  "**/engine/**",
                  "**/fields",
                  "**/fields/**",
                  "**/core",
                  "**/core/**",
                  "**/api",
                  "**/api/**"
                ],
                "message": "The UI kit contract is types and two helpers; it imports nothing of the library (ADR-0015)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/demo/src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@dynamic-form/renderer/**",
                  "!@dynamic-form/renderer/tokens.css",
                  "!@dynamic-form/renderer/core"
                ],
                "message": "Import the renderer through its two public entries only (ADR-0014, ADR-0017)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/demo/src/api/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/engine",
                  "**/engine/**",
                  "**/fields",
                  "**/fields/**",
                  "**/ui",
                  "**/ui/**",
                  "**/*.css"
                ],
                "message": "api/ talks to the network and core/ only (TDD 4.2)."
              },
              {
                "group": [
                  "@dynamic-form/renderer/**",
                  "!@dynamic-form/renderer/tokens.css",
                  "!@dynamic-form/renderer/core"
                ],
                "message": "Import the renderer through its two public entries only (ADR-0014, ADR-0017)."
              }
            ],
            "paths": [
              {
                "name": "@dynamic-form/renderer",
                "message": "api/ talks to the network and to the logic entry (@dynamic-form/renderer/core) only (TDD 4.2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/demo/src/playground/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/api", "**/api/**"],
                "message": "The playground uses a dry-run submit, never the API client (ADR-0013)."
              },
              {
                "group": [
                  "@dynamic-form/renderer/**",
                  "!@dynamic-form/renderer/tokens.css",
                  "!@dynamic-form/renderer/core"
                ],
                "message": "Import the renderer through its two public entries only (ADR-0014, ADR-0017)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/src/test/**", "tests/**", "scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
