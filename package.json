{
  "name": "dynamic-form-renderer-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite apps/demo",
    "build": "tsc --noEmit && vite build apps/demo",
    "build:lib": "vite build packages/renderer && tsc -p packages/renderer/tsconfig.build.json && node scripts/fix-declarations.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "preview": "vite preview apps/demo",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware && stylelint \"**/src/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && oxlint --type-aware && stylelint \"**/src/**/*.css\" --allow-empty-input && prettier --check . && vitest run",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-plugin-logical-css": "2.1.0",
    "typescript": "7.0.2",
    "vi-axe": "1.2.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "stylelint-plugin-logical-css": {
      "stylelint": "$stylelint"
    }
  }
}
