{
  "name": "@dynamic-form/renderer",
  "version": "0.1.0",
  "private": true,
  "description": "A form renderer for React: fetch a form description, render it, validate it and build the submission.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core-entry.ts",
      "default": "./src/core-entry.ts"
    },
    "./tokens.css": "./src/default-kit/tokens.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "zod": "^4.0.0",
    "@types/react": "^19.0.0"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "zod": "4.6.7",
    "@types/react": "19.3.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core-entry.d.ts",
        "default": "./dist/core.js"
      },
      "./styles.css": "./dist/styles.css",
      "./tokens.css": "./dist/tokens.css"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "prepack": "pnpm --workspace-root run build:lib"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
